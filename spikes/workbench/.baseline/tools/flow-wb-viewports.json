{
  "id": "transcript-workbench-viewports",
  "version": 1,
  "site": "transcript-workbench",
  "siteName": "transcript-workbench",
  "space": "flow-transcript-vp",
  "pageLabel": "vp",
  "vars": {
    "url": "http://127.0.0.1:8899/",
    "expectedUrl": "127.0.0.1:8899"
  },
  "policy": {
    "rungProbeMs": 1500,
    "actionTimeoutMs": 25000,
    "retries": 0,
    "probeMs": 300
  },
  "steps": [
    {
      "id": "open",
      "action": "goto",
      "url": "{{url}}",
      "waitUntil": "domcontentloaded",
      "timeout": 30000
    },
    {
      "id": "gate",
      "action": "guard",
      "human": false,
      "ready": { "selector": "#seg-scroll .seg", "state": "visible" },
      "urlContains": "{{expectedUrl}}",
      "errors": [
        { "selector": "#log-list li.error", "class": "site_error" }
      ],
      "timeout": 30000,
      "pollMs": 250,
      "retry": { "mode": "never" }
    },
    {
      "id": "chrome-at-default-viewport",
      "action": "assert",
      "expect": {
        "visible": [".topbar", ".wave-canvas", "#seg-scroll", ".pane-side", "#stat-grid"]
      }
    },
    {
      "id": "audio-chip-visible",
      "action": "assert",
      "expect": {
        "visible": ["#audio-info", "#seg-count"],
        "textContains": { "#audio-info": "kHz", "#seg-count": "13" }
      },
      "note": "这两条就是上一版在 1280px 下真的失败的断言：chip 被通配规则 display:none 干掉"
    },
    {
      "id": "critical-text-visible",
      "action": "assert",
      "expect": {
        "visible": ["#time-current", "#time-total", ".seg:first-child .seg-time", ".seg:first-child .spk-chip"],
        "textContains": { "#time-total": ":" }
      }
    },
    {
      "id": "stats-values-visible",
      "action": "assert",
      "expect": {
        "visible": ["#stat-grid dd"],
        "countAtLeast": { "#stat-grid dd": 8, ".spk-bar": 3 }
      }
    },
    {
      "id": "no-remote-assets",
      "action": "assert",
      "expect": {
        "countAtLeast": { "link[href^='http']": 0, "script[src^='http']": 0, "img[src^='http']": 0 }
      },
      "note": "离线约束：不加载任何指向外部的 link/script/img"
    },
    {
      "id": "spotcheck",
      "action": "extract",
      "out": "spotcheck.json",
      "dataMode": "artifact",
      "minItems": 1,
      "items": { "selector": "#stat-grid" },
      "fields": {
        "audioInfo": { "selector": "#audio-info", "attr": "text", "maxChars": null },
        "segmentCount": { "selector": "#seg-count", "attr": "text", "maxChars": null },
        "statsText": { "selector": "#stat-grid", "attr": "text", "maxChars": null },
        "firstSegment": { "selector": ".seg:first-child .seg-text", "attr": "text", "maxChars": null },
        "footerHint": { "selector": "#foot-hint", "attr": "text", "maxChars": null }
      }
    },
    {
      "id": "summary",
      "action": "note",
      "message": "视口相关断言完成：chip、时间码、统计值、说话人标记在宿主默认视口下都真实可见"
    }
  ]
}
