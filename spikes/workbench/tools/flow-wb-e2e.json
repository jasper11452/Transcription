{
  "id": "transcript-workbench-e2e",
  "version": 1,
  "site": "transcript-workbench",
  "siteName": "transcript-workbench",
  "space": "flow-transcript-wb",
  "pageLabel": "wb",
  "vars": {
    "url": "http://127.0.0.1:8899/",
    "expectedUrl": "127.0.0.1:8899"
  },
  "policy": {
    "rungProbeMs": 1500,
    "actionTimeoutMs": 25000,
    "retries": 0,
    "probeMs": 300
  },
  "steps": [
    {
      "id": "open",
      "action": "goto",
      "url": "{{url}}",
      "waitUntil": "domcontentloaded",
      "timeout": 30000
    },
    {
      "id": "gate",
      "action": "guard",
      "human": false,
      "ready": { "selector": "#seg-scroll .seg", "state": "visible" },
      "urlContains": "{{expectedUrl}}",
      "errors": [
        { "selector": "#log-list li.error", "class": "site_error" },
        { "selector": "#log-list li", "textContains": "无法解码", "class": "site_error" }
      ],
      "timeout": 30000,
      "pollMs": 250,
      "retry": { "mode": "never" }
    },
    {
      "id": "chrome-present",
      "action": "assert",
      "expect": {
        "visible": [".topbar", "#btn-play", ".wave-canvas", "#seg-scroll", "#stat-grid", ".pane-side"]
      }
    },
    {
      "id": "demo-ready",
      "action": "assert",
      "expect": {
        "countAtLeast": { ".seg": 13 },
        "textContains": { "#seg-count": "13" },
        "visible": ["#audio-info"]
      }
    },
    {
      "id": "demo-text",
      "action": "assert",
      "expect": {
        "textContains": { ".seg:first-child .seg-text": "产品评审" }
      }
    },
    {
      "id": "waveform-painted",
      "action": "assert",
      "expect": {
        "countAtLeast": { ".wave-mini": 1 },
        "visible": [".seg .seg-time", ".seg .spk-chip", ".seg .conf-chip"]
      }
    },
    {
      "id": "seek-by-timecode",
      "action": "click",
      "target": {
        "primary": ".seg:nth-child(5) .seg-time",
        "by": { "css": ".seg:nth-child(5) .seg-time" }
      },
      "description": "点第 5 段的时间码，把播放头跳过去"
    },
    {
      "id": "seeked",
      "action": "assert",
      "expect": {
        "textContains": { "#status-playhead": "00:26" },
        "countAtLeast": { ".seg.is-active": 1 }
      }
    },
    {
      "id": "play",
      "action": "click",
      "target": {
        "primary": "#btn-play",
        "by": { "css": "#btn-play" }
      }
    },
    {
      "id": "playing",
      "action": "assert",
      "expect": {
        "visible": ["body.mode-playback"],
        "textContains": { "#status-playhead": "00:2" }
      }
    },
    {
      "id": "pause",
      "action": "click",
      "target": {
        "primary": "#btn-play",
        "by": { "css": "#btn-play" }
      }
    },
    {
      "id": "paused",
      "action": "assert",
      "expect": {
        "hidden": ["body.mode-playback"]
      }
    },
    {
      "id": "open-editor",
      "action": "click",
      "target": {
        "primary": ".seg:nth-child(3) .seg-text",
        "by": { "css": ".seg:nth-child(3) .seg-text" }
      },
      "description": "点第 3 段正文"
    },
    {
      "id": "edit-mode",
      "action": "probe",
      "probe": [
        { "label": "可编辑正文", "selector": ".seg.is-editing .seg-text[contenteditable=true]", "count": true },
        { "label": "编辑器已获焦", "any": [".seg.is-editing"], "state": "visible" }
      ]
    },
    {
      "id": "search",
      "action": "fill",
      "target": {
        "primary": "#search",
        "by": { "css": "#search" }
      },
      "value": "热词",
      "description": "搜索「热词」"
    },
    {
      "id": "search-hits",
      "action": "assert",
      "expect": {
        "countAtLeast": { ".seg-text mark.hl": 1, ".seg": 2 },
        "textContains": { "#search-hits": "命中" }
      }
    },
    {
      "id": "clear-search",
      "action": "fill",
      "target": {
        "primary": "#search",
        "by": { "css": "#search" }
      },
      "value": ""
    },
    {
      "id": "search-cleared",
      "action": "assert",
      "expect": {
        "countAtLeast": { ".seg": 13 }
      }
    },
    {
      "id": "filter-low",
      "action": "click",
      "target": {
        "primary": "#btn-filter-low",
        "by": { "css": "#btn-filter-low" }
      },
      "description": "只显示低置信度分段"
    },
    {
      "id": "filtered",
      "action": "assert",
      "expect": {
        "countAtLeast": { ".seg": 3, ".conf-chip.is-low": 3 },
        "textContains": { "#btn-filter-low": "低置信" }
      }
    },
    {
      "id": "filter-clear-via-menu",
      "action": "click",
      "target": {
        "primary": "#filter-menu > summary",
        "by": { "css": "#filter-menu > summary" }
      },
      "description": "展开「更多」下拉"
    },
    {
      "id": "menu-open",
      "action": "probe",
      "probe": [{ "label": "下拉项可见", "selector": "#btn-filter-clear", "state": "visible", "count": true }]
    },
    {
      "id": "clear-filters",
      "action": "click",
      "target": {
        "primary": "#btn-filter-clear",
        "by": { "css": "#btn-filter-clear" }
      }
    },
    {
      "id": "filters-cleared",
      "action": "assert",
      "expect": {
        "countAtLeast": { ".seg": 13 }
      }
    },
    {
      "id": "open-export",
      "action": "click",
      "target": {
        "primary": "#btn-export",
        "by": { "css": "#btn-export" }
      },
      "description": "打开导出弹窗"
    },
    {
      "id": "export-dialog",
      "action": "assert",
      "expect": {
        "visible": [".modal", "#export-preview", "#export-grid"],
        "countAtLeast": { ".export-card": 5 },
        "textContains": { "#export-preview": "00:00:00" }
      }
    },
    {
      "id": "export-precheck",
      "action": "assert",
      "expect": {
        "textContains": { "#export-warn": "检查通过" }
      }
    },
    {
      "id": "export-structure",
      "action": "extract",
      "out": "product.json",
      "dataMode": "artifact",
      "minItems": 1,
      "items": { "selector": ".modal" },
      "fields": {
        "precheck": { "selector": "#export-warn", "maxChars": null },
        "dialogTitle": { "selector": "#modal-title", "maxChars": null },
        "previewText": { "selector": "#export-preview", "maxChars": null },
        "firstCardLabel": { "selector": ".export-card strong", "maxChars": null }
      },
      "note": "容器是弹窗本身，字段在容器内部查找；必须在关弹窗之前跑。上次放在了 close-export 之后，采到全 null 却仍报 ok"
    },
    {
      "id": "close-export",
      "action": "click",
      "target": {
        "primary": ".modal-close",
        "by": { "css": ".modal-close" }
      }
    },
    {
      "id": "export-closed",
      "action": "assert",
      "expect": {
        "hidden": [".modal"]
      }
    },
    {
      "id": "open-palette",
      "action": "click",
      "target": {
        "primary": "#btn-palette",
        "by": { "css": "#btn-palette" }
      },
      "description": "命令面板"
    },
    {
      "id": "palette-open",
      "action": "assert",
      "expect": {
        "visible": [".palette", ".palette-input"],
        "countAtLeast": { ".palette-item": 20 }
      }
    },
    {
      "id": "palette-filter",
      "action": "fill",
      "target": {
        "primary": ".palette-input",
        "by": { "css": ".palette-input" }
      },
      "value": "导出"
    },
    {
      "id": "palette-filtered",
      "action": "assert",
      "expect": {
        "textContains": { ".palette-item:first-child .palette-title": "导出" }
      }
    },
    {
      "id": "palette-close",
      "action": "press",
      "target": {
        "primary": ".palette-input",
        "by": { "css": ".palette-input" }
      },
      "value": "Escape"
    },
    {
      "id": "palette-closed",
      "action": "assert",
      "expect": { "hidden": [".palette"] }
    },
    {
      "id": "help-open",
      "action": "click",
      "target": {
        "primary": "#btn-help",
        "by": { "css": "#btn-help" }
      }
    },
    {
      "id": "help-content",
      "action": "assert",
      "expect": {
        "countAtLeast": { ".shortcut-row": 25, ".shortcut-group": 4 },
        "textContains": { ".modal-body": "撤销" }
      }
    },
    {
      "id": "help-close",
      "action": "press",
      "target": {
        "primary": "#btn-help",
        "by": { "css": "#btn-help" }
      },
      "value": "Escape"
    },
    {
      "id": "split-segment",
      "action": "click",
      "target": {
        "primary": ".seg:nth-child(2) .seg-tools button[data-act=split]",
        "by": { "css": ".seg:nth-child(2) [data-act=split]" }
      },
      "description": "拆分第 2 段"
    },
    {
      "id": "split-applied",
      "action": "assert",
      "expect": {
        "countAtLeast": { ".seg": 14 },
        "textContains": { "#seg-count": "14" }
      }
    },
    {
      "id": "undo-split",
      "action": "click",
      "target": {
        "primary": "#btn-undo",
        "by": { "css": "#btn-undo" }
      }
    },
    {
      "id": "split-undone",
      "action": "assert",
      "expect": {
        "countAtLeast": { ".seg": 13 },
        "textContains": { "#status-history": "可重做" }
      }
    },
    {
      "id": "theme-cycle",
      "action": "click",
      "target": {
        "primary": "#btn-theme",
        "by": { "css": "#btn-theme" }
      }
    },
    {
      "id": "theme-changed",
      "action": "probe",
      "probe": [
        { "label": "浅色主题", "any": ["html[data-theme=light]"], "state": "attached" },
        { "label": "深色主题", "any": ["html[data-theme=dark]"], "state": "attached" }
      ]
    },
    {
      "id": "stats-rendered",
      "action": "assert",
      "expect": {
        "countAtLeast": { "#stat-grid dt": 8, ".spk-bar": 3 },
        "visible": ["#stat-grid"]
      }
    },
    {
      "id": "no-remote-assets",
      "action": "assert",
      "expect": {
        "countAtLeast": { "link[href^='http']": 0, "script[src^='http']": 0, "img[src^='http']": 0 }
      },
      "note": "离线约束：页面里不许出现指向外部的 link/script/img"
    },
    {
      "id": "a11y-shape",
      "action": "assert",
      "expect": {
        "countAtLeast": { "main": 1, "[role=slider]": 1, "[role=listitem]": 13 }
      }
    },
    {
      "id": "reload-persistence",
      "action": "goto",
      "url": "{{url}}",
      "waitUntil": "domcontentloaded",
      "timeout": 30000
    },
    {
      "id": "persisted",
      "action": "assert",
      "expect": {
        "countAtLeast": { ".seg": 13 },
        "textContains": { ".seg:first-child .seg-text": "产品评审" }
      },
      "note": "刷新后应从本地存档恢复，而不是回到空白"
    },
    {
      "id": "summary",
      "action": "note",
      "message": "端到端完成：{{url}}（载入演示音频 → 定位 → 播放 → 搜索 → 筛选 → 导出 → 命令面板 → 拆分/撤销 → 刷新恢复）"
    }
  ]
}
