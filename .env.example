# BCut ASR configuration
# Base URL of the BCut API, e.g. https://api.bcut.ai
BCUT_BASE_URL=

# API key for authenticating with BCut
BCUT_API_KEY=

# Optional: Path for the transcribe endpoint relative to BCUT_BASE_URL
# Defaults to /v1/transcribe if not set
BCUT_TRANSCRIBE_PATH=/v1/transcribe

# Optional: Default language hint to send to BCut (e.g., en, zh, auto)
BCUT_LANGUAGE=

# Optional: Default model name to use
BCUT_MODEL=

# Optional: Default prompt or biasing text for the recognizer
BCUT_PROMPT=

# Optional: Timeout in milliseconds for BCut requests (default 120000)
BCUT_TIMEOUT_MS=120000

# Upload settings
# Maximum upload size in MB (default 100)
UPLOAD_MAX_MB=100

# Rate limit
# Requests per minute per IP (default 60)
RATE_LIMIT_RPM=60
